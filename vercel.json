{
  "version": 2,
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
